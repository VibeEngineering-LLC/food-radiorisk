{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "food-radiorisk/life_risks.schema.json",
  "title": "Вероятность умереть от обычных причин в России за 50 лет (взрослый 20→70) и до 70 лет (ребёнок 0→70) (#FR-79); таблица дожития и доли причин по возрастным группам (#FR-81 V05)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "label_ru", "year", "source", "loc", "level", "unit_norm", "unit_factor", "unit_inferred"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_.\\-]+$" },
    "kind": { "enum": ["cause", "incidence_ref", "life_table", "cause_shares"] },
    "label_ru": { "type": "string", "minLength": 1 },
    "adult": { "$ref": "#/$defs/bySex" },
    "child": { "$ref": "#/$defs/bySex" },
    "code": { "type": "string", "pattern": "^[0-9]{4}$" },
    "nodes": { "type": "array", "minItems": 2, "items": { "type": "integer", "minimum": 0 } },
    "lx": { "$ref": "#/$defs/lxBySex" },
    "births": { "$ref": "#/$defs/birthsBySex" },
    "groups": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": ["integer", "null"], "minimum": 0 } } },
    "deaths": { "$ref": "#/$defs/countsBySex" },
    "share": { "$ref": "#/$defs/sharesBySex" },
    "rosstat_check": { "type": "string", "minLength": 1 },
    "ref_dataset": { "type": "string", "minLength": 1 },
    "ref_id": { "type": "string", "minLength": 1 },
    "year": { "type": "integer", "minimum": 1990, "maximum": 2100 },
    "source": { "type": "string", "minLength": 1 },
    "source_also": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "loc": { "type": "string", "minLength": 1 },
    "quote": { "type": "string", "minLength": 1 },
    "method": { "type": "string", "minLength": 1 },
    "note": { "type": "string", "minLength": 1 },
    "level": { "enum": ["✅", "📗", "⚠️"] },
    "unit_norm": { "type": ["string", "null"] },
    "unit_factor": { "type": ["number", "null"] },
    "unit_inferred": { "type": "boolean" }
  },
  "anyOf": [
    { "required": ["quote"] },
    { "required": ["method"] }
  ],
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "cause" } }, "required": ["kind"] },
      "then": { "required": ["adult", "child"], "not": { "anyOf": [{ "required": ["ref_dataset"] }, { "required": ["ref_id"] }] } }
    },
    {
      "if": { "properties": { "kind": { "const": "life_table" } }, "required": ["kind"] },
      "then": { "required": ["nodes", "lx", "births", "groups"], "not": { "anyOf": [{ "required": ["adult"] }, { "required": ["child"] }, { "required": ["code"] }, { "required": ["deaths"] }, { "required": ["share"] }] } }
    },
    {
      "if": { "properties": { "kind": { "const": "cause_shares" } }, "required": ["kind"] },
      "then": { "required": ["code", "deaths", "share"], "not": { "anyOf": [{ "required": ["adult"] }, { "required": ["child"] }, { "required": ["lx"] }, { "required": ["nodes"] }] } }
    },
    {
      "if": { "properties": { "kind": { "const": "incidence_ref" } }, "required": ["kind"] },
      "then": { "required": ["ref_dataset", "ref_id"], "not": { "anyOf": [{ "required": ["adult"] }, { "required": ["child"] }] } }
    }
  ],
  "$defs": {
    "prob": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
    "lxBySex": { "type": "object", "additionalProperties": false, "required": ["male", "female"], "properties": { "male": { "type": "array", "items": { "type": "integer", "minimum": 0 } }, "female": { "type": "array", "items": { "type": "integer", "minimum": 0 } } } },
    "birthsBySex": { "type": "object", "additionalProperties": false, "required": ["male", "female"], "properties": { "male": { "type": "integer", "minimum": 1 }, "female": { "type": "integer", "minimum": 1 } } },
    "countsBySex": { "type": "object", "additionalProperties": false, "required": ["male", "female"], "properties": { "male": { "type": "array", "items": { "type": "integer", "minimum": 0 } }, "female": { "type": "array", "items": { "type": "integer", "minimum": 0 } } } },
    "sharesBySex": { "type": "object", "additionalProperties": false, "required": ["male", "female"], "properties": { "male": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 } }, "female": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 } } } },
    "bySex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["both", "male", "female"],
      "properties": {
        "both": { "$ref": "#/$defs/prob" },
        "male": { "$ref": "#/$defs/prob" },
        "female": { "$ref": "#/$defs/prob" }
      }
    }
  }
}
