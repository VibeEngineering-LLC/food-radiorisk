{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "food-radiorisk/transfer.schema.json",
  "title": "Запись коэффициента перехода и вспомогательного параметра (Fv, Tag, Fm, Ff, КП, сухое вещество, почва)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source", "loc", "quantity", "nuclide", "item", "item_ru", "food_group", "soil_type", "mass_basis", "unit", "n", "gm", "gsd", "am", "sd", "min", "max", "quote", "checked_against", "level", "note", "unit_norm", "unit_factor", "unit_inferred"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.\\-]+$"},
    "source": {"type": "string", "minLength": 1},
    "loc": {"type": "string", "minLength": 1},
    "quantity": {"enum": ["Fv", "Tag", "dry_matter", "KP", "Ff", "Fm", "meat_fraction", "dose_rate_per_deposition", "feed_intake", "soil_depth", "soil_bulk_density", "soil_mass_depth", "CR", "ambient_dose_rate_per_deposition", "burial_coefficient", "depth_attenuation_factor"]},
    "nuclide": {"type": "string", "minLength": 1},
    "item": {"type": "string", "minLength": 1},
    "item_ru": {"type": "string", "minLength": 1},
    "food_group": {"type": "string", "minLength": 1},
    "soil_type": {"type": ["string", "null"]},
    "mass_basis": {"enum": ["dry", "fresh", null]},
    "unit": {"type": "string", "minLength": 1},
    "n": {"type": ["integer", "null"], "minimum": 1},
    "gm": {"type": ["number", "null"]},
    "gsd": {"type": ["number", "null"]},
    "am": {"type": ["number", "null"]},
    "sd": {"type": ["number", "null"]},
    "min": {"type": ["number", "null"]},
    "max": {"type": ["number", "null"]},
    "quote": {"type": ["string", "null"]},
    "checked_against": {"type": "string", "minLength": 1},
    "level": {"enum": ["✅", "📗", "⚠️"]},
    "note": {"type": "string"},
    "source_anomaly": {"type": "string", "minLength": 1},
    "unit_norm": {"type": ["string", "null"]},
    "unit_factor": {"type": ["number", "null"]},
    "unit_inferred": {"type": "boolean"},
    "mass_basis_status": {"enum": ["stated", "inferred", "assumed"]},
    "mass_basis_note": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"$comment": "#FR-33: у КП (Tag, KP) основа массы обязательна; не прямо из источника — со статусом и обоснованием",
     "if": {"properties": {"quantity": {"enum": ["Tag", "KP"]}}},
     "then": {"properties": {"mass_basis": {"enum": ["dry", "fresh"]}}}},
    {"if": {"required": ["mass_basis_status"], "properties": {"mass_basis_status": {"enum": ["inferred", "assumed"]}}},
     "then": {"required": ["mass_basis_note"]}}
  ]
}
