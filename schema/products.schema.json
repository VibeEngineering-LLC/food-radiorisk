{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "food-radiorisk/products.schema.json",
  "title": "Единый словарь продуктов (#FR-85, D-024): модификаторы состояния (kind: modifier), лексикон сопоставления (kind: lexicon — стоп-слова и особые формы, #FR-85 v11), выборы для неоднозначных названий (kind: choice) и продукты (kind: product) с явными ссылками на норматив, класс Codex/EU, группу рациона, обработку, коэффициенты перехода и сухое вещество. Ссылки проверяет tools/products_check.py",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "unit_norm", "unit_factor", "unit_inferred"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "kind": { "enum": ["modifier", "product", "lexicon", "choice"] },
    "state": { "enum": ["fresh", "dried", "cooked"] },
    "words": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "name_ru": { "type": "string", "minLength": 1 },
    "synonyms": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "hidden_synonyms": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "stopwords": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "forms": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "neutral": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["why", "words"],
        "properties": {
          "why": { "type": "string", "minLength": 20 },
          "words": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "entries": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^p_[a-z0-9_]+$" }, "uniqueItems": true },
          "diet_groups": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "uniqueItems": true }
        }
      }
    },
    "generic": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["why", "words", "entry"],
        "properties": {
          "why": { "type": "string", "minLength": 20 },
          "words": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "entry": { "type": "string", "pattern": "^p_[a-z0-9_]+$" }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "why", "words"],
        "properties": {
          "kind": { "enum": ["dish", "changes"] },
          "why": { "type": "string", "minLength": 20 },
          "words": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "entries": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^p_[a-z0-9_]+$" }, "uniqueItems": true }
        }
      }
    },
    "regroup": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["why", "words", "from_groups", "to"],
        "properties": {
          "why": { "type": "string", "minLength": 20 },
          "words": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "from_groups": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "uniqueItems": true },
          "to": { "type": "string", "pattern": "^[a-z0-9_]+$" }
        }
      }
    },
    "intervention": { "enum": ["nrb2009_app2a"] },
    "options": { "type": "array", "minItems": 2, "items": { "type": "string", "pattern": "^p_[a-z0-9_]+$" }, "uniqueItems": true },
    "states": { "type": "array", "minItems": 1, "items": { "enum": ["fresh", "dried", "cooked"] }, "uniqueItems": true },
    "modifiers_change_product": { "type": "boolean" },
    "norm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fresh", "dried"],
      "properties": {
        "fresh": { "type": ["string", "null"], "minLength": 1 },
        "dried": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "codex": { "type": "array", "minItems": 1, "items": { "enum": ["infant", "milk", "water", "liquid", "minor", "general"] }, "uniqueItems": true },
    "diet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "base", "factor"],
      "properties": {
        "group": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" },
        "base": { "type": "boolean" },
        "factor": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "factor_source": { "type": "string", "minLength": 1 }
      }
    },
    "processing": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "transfer": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "dry_matter": { "type": ["string", "null"], "minLength": 1 },
    "note": { "type": "string" },
    "decided": { "type": ["string", "null"], "minLength": 1 },
    "caption": { "type": "string", "minLength": 1 },
    "unit_norm": { "type": ["string", "null"] },
    "unit_factor": { "type": ["number", "null"] },
    "unit_inferred": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "lexicon" } }, "required": ["kind"] },
      "then": { "required": ["stopwords", "forms"] }
    },
    {
      "if": { "properties": { "kind": { "const": "choice" } }, "required": ["kind"] },
      "then": { "required": ["name_ru", "synonyms", "options", "note"] }
    },
    {
      "if": { "properties": { "kind": { "const": "modifier" } }, "required": ["kind"] },
      "then": { "required": ["state", "words"] }
    },
    {
      "if": { "properties": { "kind": { "const": "product" } }, "required": ["kind"] },
      "then": { "required": ["name_ru", "synonyms", "states", "modifiers_change_product", "norm", "codex", "diet", "processing", "transfer", "dry_matter", "note", "decided"] }
    }
  ]
}
