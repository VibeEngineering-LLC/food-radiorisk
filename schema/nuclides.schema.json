{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "food-radiorisk/nuclides.schema.json",
  "title": "Запись периода полураспада нуклида (ICRP 107 / DDEP / ENSDF / NUBASE)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "nuclide", "half_life", "unit", "half_life_days", "uncertainty", "uncertainty_days", "source", "loc", "url", "retrieved", "quote", "checked_against", "level", "note", "unit_norm", "unit_factor", "unit_inferred"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.\\-]+$"},
    "nuclide": {"type": "string", "pattern": "^[A-Z][a-z]?-[0-9]{1,3}m?$"},
    "half_life": {"type": "number", "exclusiveMinimum": 0},
    "unit": {"enum": ["s", "min", "h", "d", "y"]},
    "half_life_days": {"type": "number", "exclusiveMinimum": 0},
    "uncertainty": {"type": ["number", "null"], "minimum": 0},
    "uncertainty_days": {"type": ["number", "null"], "minimum": 0},
    "source": {"type": "string", "minLength": 1},
    "loc": {"type": "string", "minLength": 1},
    "url": {"type": ["string", "null"]},
    "retrieved": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "quote": {"type": "string", "minLength": 1},
    "checked_against": {"type": "string", "minLength": 1},
    "level": {"enum": ["✅", "📗", "⚠️"]},
    "note": {"type": "string"},
    "recommended": {"type": "boolean"},
    "source_anomaly": {"type": "string", "minLength": 1},
    "unit_norm": {"type": ["string", "null"]},
    "unit_factor": {"type": ["number", "null"]},
    "unit_inferred": {"type": "boolean"}
  }
}
