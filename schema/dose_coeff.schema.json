{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "food-radiorisk/dose_coeff.schema.json",
  "title": "Запись коэффициента дозы e(g) при поступлении с пищей/водой",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source", "nuclide", "route", "age", "f1", "form", "value", "unit", "includes_progeny", "loc", "checked_against", "level", "unit_norm", "unit_factor", "unit_inferred"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.\\-]+$"},
    "source": {"type": "string", "minLength": 1},
    "nuclide": {"type": "string", "pattern": "^[A-Z][a-z]?-[0-9]{1,3}m?$"},
    "route": {"type": "string", "minLength": 1},
    "age": {"type": "string", "enum": ["3m", "1y", "5y", "10y", "15y", "adult", "1-2y", "2-7y", "7-12y", "12-17y"]},
    "f1": {"type": ["number", "null"]},
    "f1_note": {"type": "string"},
    "form": {"type": ["string", "null"]},
    "value": {"type": "number"},
    "unit": {"const": "Sv/Bq"},
    "includes_progeny": {"type": ["string", "null"]},
    "crit_group": {"type": "string"},
    "pgp_bq_per_year": {"type": ["number", "null"]},
    "uv_bq_per_kg": {"type": ["number", "null"]},
    "loc": {"type": "string", "minLength": 1},
    "checked_against": {"type": "string", "minLength": 1},
    "level": {"enum": ["✅", "📗", "⚠️"]},
    "source_anomaly": {"type": "string", "minLength": 1},
    "unit_norm": {"type": ["string", "null"]},
    "unit_factor": {"type": ["number", "null"]},
    "unit_inferred": {"type": "boolean"}
  }
}
